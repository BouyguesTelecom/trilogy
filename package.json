{
  "name": "trilogy-v5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version": "changeset version",
    "start:web": "pnpm --filter @trilogy-ds/cross-app start:web",
    "start:mobile": "pnpm --filter @trilogy-ds/cross-app start:mobile",
    "generate": "node scripts/generate/index.js",
    "generate:tokens": "node scripts/generate/index.js tokens",
    "generate:components": "node scripts/generate/index.js components",
    "generate:props": "node scripts/generate/index.js props",
    "release": "turbo build && changeset publish",
    "start": "pnpm start:web"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/config-conventional": "^21.2.4",
    "@figma/code-connect": "^2.0.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^10.13.0",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "expo": "~58.0.22",
    "prettier": "3.9.6",
    "react": "catalog:",
    "react-native": "catalog:",
    "style-dictionary": "^5.7.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
