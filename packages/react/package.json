{
  "name": "@trilogy-ds/react",
  "version": "5.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "expo lint",
    "build": "tsdown",
    "check-docs": "node ../../apps/doc/scripts/check-component-docs.mjs",
    "test": "pnpm test:web && pnpm test:native",
    "test:web": "vitest run",
    "test:native": "jest --config jest.config.cjs --runInBand",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.native.json --noEmit",
    "test:coverage": "vitest run --coverage && jest --config jest.config.cjs --runInBand --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "jsdom": "^31.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "~0.21.4",
    "test-renderer": "^1.3.1",
    "tsdown": "^0.23.1",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./*": {
      "react-native": {
        "types": "./dist/native/*/index.d.ts",
        "default": "./dist/native/*/index.js"
      },
      "import": {
        "types": "./dist/web/*/index.d.ts",
        "default": "./dist/web/*/index.js"
      },
      "require": {
        "types": "./dist/web/*/index.d.cts",
        "default": "./dist/web/*/index.cjs"
      }
    }
  }
}
