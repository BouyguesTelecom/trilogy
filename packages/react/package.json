{
  "name": "@trilogy-ds/react",
  "version": "5.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "expo lint",
    "build": "tsdown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "tsdown": "^0.23.1"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./*": {
      "react-native": {
        "types": "./dist/native/*/index.d.ts",
        "default": "./dist/native/*/index.js"
      },
      "import": {
        "types": "./dist/web/*/index.d.ts",
        "default": "./dist/web/*/index.js"
      },
      "require": {
        "types": "./dist/web/*/index.d.cts",
        "default": "./dist/web/*/index.cjs"
      }
    }
  }
}
